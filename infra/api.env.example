# Everything the stack reads from its environment, with the value it
# uses when the variable is absent. Copy this to `api.env` beside it,
# fill in what you mean, and never commit the filled copy: two of
# these are secrets.
#
#   cp infra/api.env.example infra/api.env

# ---------------------------------------------------------------- core

# Where every resident, every stored byte, and every per-resident
# database lives. Inside a container this is the mounted volume; on a
# plain box, a directory that survives deploys. Losing it loses
# everyone's apps, so it is also what the backup script copies.
OSYLE_DATA=/data

# The port the server listens on. A reverse proxy in front of it is
# what the world actually talks to.
PORT=8787

NODE_ENV=production

# ------------------------------------------------------------- origins

# The one origin the browser may call with credentials, and the only
# place a letter's link will ever send anyone. Without it the api
# accepts any origin, which is fine locally and wrong in public.
# Default: http://localhost:5173
OSYLE_APP_ORIGIN=https://osyle.xyz

# The api's own public address, so a link inside a letter is absolute
# and comes back to the right machine. Default: read from the request.
OSYLE_API_ORIGIN=https://api.osyle.xyz

# --------------------------------------------------------------- mail

# The Resend key. A secret: keep it here, never in the repository.
# Without it the sign-in door answers honestly, says no provider is
# configured, and hands the link back so a local stack still works.
OSYLE_RESEND_KEY=

# The sender. Resend refuses to send from a domain it has not
# verified, so this is a DNS step in their dashboard before the first
# letter goes anywhere. Default: Osyle <hello@osyle.xyz>
OSYLE_MAIL_FROM=Osyle <hello@osyle.xyz>

# ------------------------------------------------------- limits, tuned

# Requests per minute per address on the general doors. Default: 240
OSYLE_RATE_MAX=240

# The largest repository zip the proxy will pull. Default: 15 MB
OSYLE_REPO_ZIP_BYTES=15728640

# What one resident may keep in the Vault. Defaults: 5 MB a file,
# 64 MB in total, 500 paths.
OSYLE_VAULT_FILE_BYTES=5242880
OSYLE_VAULT_BYTES=67108864
OSYLE_VAULT_PATHS=500

# ---------------------------------------------------- the caretaker

# How often the caretaker looks at each resident, and how often it
# sweeps for residents due a look. Defaults: every 24 hours, swept
# hourly. Set OSYLE_ROUNDS=off to stop the clock entirely, which is
# what the load drill does so its numbers measure only the doors.
OSYLE_ROUND_EVERY_MS=86400000
OSYLE_ROUND_SWEEP_MS=3600000
# OSYLE_ROUNDS=off
